# ================================================================
# Supabase
# ================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ================================================================
# Google Drive
# ================================================================
# Folder tujuan utama di Google Drive.
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# --- Recommended for a personal @gmail.com Google Drive ---
# OAuth 2.0 refresh token is stored ONLY in your local .env.local.
# Do NOT commit the real values to GitHub.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=your-oauth-refresh-token

# --- Optional legacy/team fallback ---
# If the three OAuth variables above are not set, Drive falls back to
# the existing Service Account authentication below. This keeps the
# shared project compatible with the previous setup.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"

# ================================================================
# Telegram Bot
# ================================================================
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Grup Telegram Tim Operasional (opsional): notifikasi setiap ada pengajuan
# baru / diajukan ulang. Masukkan bot ke grup, lalu isi Chat ID grup
# (angka negatif, mis. -1001234567890).
TELEGRAM_OPS_CHAT_ID=
